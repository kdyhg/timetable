{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?__path="
    },
    {
      "source": "/:path*",
      "destination": "/api?__path=:path*"
    }
  ]
}
